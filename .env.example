APP_ENV=development
LOCAL_DEMO_MODE=false
DEBUG=false
BASE_URL=http://localhost:8000

# MongoDB Atlas connection (Atlas deployments support transactions)
MONGODB_URI=
MONGODB_DATABASE=secureshare

# Cloudinary stores the AES-GCM encrypted payload; files are proxied through the app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP delivery for email verification, password recovery and sharing updates (SMTP_HOST; MAIL_SERVER also accepted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="SecureShare <no-reply@example.edu>"

# Generate unique secrets; ENCRYPTION_KEY must be URL-safe base64 for exactly 32 bytes
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

MAX_UPLOAD_BYTES=104857600
STORAGE_QUOTA_BYTES=2147483648
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
